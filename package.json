{
  "name": "j-paku-github-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-sprites.mjs && next dev",
    "build": "node scripts/build-sprites.mjs && next build && node scripts/verify-export.mjs",
    "start": "serve out -l 4173",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "budoux": "^0.9.0",
    "next": "^16.3.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "^15.4.8",
    "playwright": "^1.63.0",
    "prettier": "^3.7.4",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
