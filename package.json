{
  "name": "j-paku-github-io",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-sprites.mjs && next dev",
    "build": "node scripts/build-sprites.mjs && next build && node scripts/verify-export.mjs",
    "start": "serve out -l 4173",
    "lint": "eslint .",
    "test": "TZ=UTC vitest run",
    "test:coverage": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest",
    "test:mutation": "TZ=UTC stryker run",
    "test:boundary": "node scripts/check-test-boundary.mjs && node scripts/check-layers.mjs && node scripts/check-coverage-ignores.mjs",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run docs:check && npm run lint && npm run format:check && npm run test:coverage && npm run test:boundary && npm run test:integration && npm run build",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.md\" \"{docs,src,scripts,tests,content}/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"content/**/*.ts\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"*.md\" \"{docs,src,scripts,tests,content}/**/*.md\""
  },
  "dependencies": {
    "budoux": "^0.9.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "happy-dom": "^21.0.1",
    "playwright": "^1.63.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "~6.0.2",
    "vitest": "^4.1.10",
    "wait-on": "^9.5.1"
  }
}
